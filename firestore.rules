rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // A new profile may be "citizen", or "staff" only if it carries the
    // correct invite code. The check happens here, server-side, so calling
    // Firestore directly can't skip it. get() fails if the config doc is
    // missing, which denies staff sign-up rather than allowing it.
    function isValidNewProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly(['email', 'role', 'createdAt', 'staffCode'])
          && (data.role == "citizen"
              || (data.role == "staff"
                  && data.get('staffCode', '') == get(/databases/$(database)/documents/config/staffInviteCode).data.code));
    }

    // Each user can read/create their own profile doc, and can update it
    // as long as they don't change their own role after creation.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidNewProfile();
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Never readable or writable from a client — the staff code is only
    // compared inside isValidNewProfile() above.
    match /config/{docId} {
      allow read, write: if false;
    }

    // Written by ReportService.swift. Field names and the status values
    // ("reported", "inProgress", "resolved") match Report.swift.
    match /reports/{reportId} {
      allow read: if isSignedIn();

      // The only change a non-owner may make: adding or removing their own
      // uid in upvoterIds, so each user can upvote a report at most once.
      function isOwnUpvoteChange() {
        let before = resource.data.get('upvoterIds', []).toSet();
        let after = request.resource.data.get('upvoterIds', []).toSet();
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoterIds'])
            && after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
      }

      // A citizen may only create a report as themselves, only with the
      // initial status and no upvotes — they cannot set an arbitrary status
      // (e.g. "resolved") or fake upvotes at creation time. Without this, the
      // create path defeats the whole point of the update rule below.
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == "reported"
                    && request.resource.data.upvoterIds == [];

      // Staff can change anything, including status. The reporter may edit
      // their own report, but not its status, owner or upvotes. Anyone
      // signed in may toggle their own upvote.
      allow update: if isSignedIn() &&
                     (
                       userRole() == "staff" ||
                       (
                         resource.data.reporterId == request.auth.uid &&
                         request.resource.data.status == resource.data.status &&
                         request.resource.data.reporterId == resource.data.reporterId &&
                         request.resource.data.get('upvoterIds', []) == resource.data.get('upvoterIds', [])
                       ) ||
                       isOwnUpvoteChange()
                     );

      allow delete: if false;
    }

    // One photo per report, written by ReportService.swift in the same
    // batch as the report. getAfter() sees that batched report, so only the
    // report's own reporter can attach its photo. Anyone signed in (citizen
    // or staff) can view it. Size limit matches maxPhotoBytes in the app.
    match /reportPhotos/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['data'])
                    && request.resource.data.data is bytes
                    && request.resource.data.data.size() < 900 * 1024;
      allow update, delete: if false;
    }
  }
}
