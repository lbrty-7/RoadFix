rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Set by Firebase once the user opens the link in the verification email.
    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    function isShortText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // A new profile may be "citizen", or "staff" only if it carries the
    // correct invite code. The check happens here, server-side, so calling
    // Firestore directly can't skip it. get() fails if the config doc is
    // missing, which denies staff sign-up rather than allowing it.
    function isValidNewProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly(['email', 'role', 'createdAt', 'staffCode', 'termsAcceptedAt'])
          && data.email == request.auth.token.email
          && (data.role == "citizen"
              || (data.role == "staff"
                  && data.get('staffCode', '') == get(/databases/$(database)/documents/config/staffInviteCode).data.code));
    }

    // Each user can read/create their own profile doc. The only later change
    // is lastReportAt, stamped with the server time in the same batch as each
    // new report (see the one-per-minute limit below), so nobody can change
    // their own role. They can delete it as part of deleting their account
    // (DeleteAccountView).
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidNewProfile();
      allow update: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReportAt'])
                    && request.resource.data.lastReportAt == request.time;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Never readable or writable from a client — the staff code is only
    // compared inside isValidNewProfile() above.
    match /config/{docId} {
      allow read, write: if false;
    }

    // Written by ReportService.swift. Field names and the status values
    // ("reported", "inProgress", "resolved") match Report.swift.
    match /reports/{reportId} {
      // Lists are capped (ReportService.listLimit) so the whole collection
      // can't be scraped in one request. A user's own reports can always be
      // listed in full, which deleting an account needs.
      allow get: if isSignedIn();
      allow list: if isSignedIn()
                  && (request.query.limit <= 500 || resource.data.reporterId == request.auth.uid);

      // At most one new report per account per minute. lastReportAt is the
      // time of the user's previous report; the batch must stamp it again.
      function isNotTooSoon() {
        let before = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let after = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return after.get('lastReportAt', null) == request.time
            && (before.get('lastReportAt', null) == null
                || request.time > before.lastReportAt + duration.value(1, 'm'));
      }

      function isValidReport(data) {
        return data.category in ['pothole', 'streetlight', 'sidewalk', 'markings', 'other']
            && isShortText(data.description, 2000);
      }

      // The only change a non-owner may make: adding or removing their own
      // uid in upvoterIds, so each user can upvote a report at most once.
      function isOwnUpvoteChange() {
        let before = resource.data.get('upvoterIds', []).toSet();
        let after = request.resource.data.get('upvoterIds', []).toSet();
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvoterIds'])
            && after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
      }

      // A citizen may only create a report as themselves, only with the
      // initial status and no upvotes — they cannot set an arbitrary status
      // (e.g. "resolved") or fake upvotes at creation time. Without this, the
      // create path defeats the whole point of the update rule below.
      // Staff-only fields (staffNote, statusHistory) can't be set either.
      // The email must be verified, every field is type- and size-checked,
      // and isNotTooSoon() limits each account to one report per minute.
      allow create: if isSignedIn()
                    && isVerified()
                    && isNotTooSoon()
                    && request.resource.data.keys().hasOnly(['category', 'description', 'latitude', 'longitude',
                         'status', 'upvoterIds', 'reporterId', 'hasPhoto', 'createdAt', 'address'])
                    && isValidReport(request.resource.data)
                    && request.resource.data.latitude is number
                    && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
                    && request.resource.data.longitude is number
                    && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180
                    && request.resource.data.hasPhoto is bool
                    && request.resource.data.createdAt == request.time
                    && (!('address' in request.resource.data) || isShortText(request.resource.data.address, 300))
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.status == "reported"
                    && request.resource.data.upvoterIds == []
                    && !request.resource.data.keys().hasAny(['staffNote', 'statusHistory']);
      // (The hasOnly() list above already excludes staffNote and
      // statusHistory; the check is kept so the intent stays obvious.)

      // Staff can change status, statusHistory and staffNote, as long as the
      // status is a known one and the note isn't oversized.
      // The reporter may only fix the category and description of their own
      // report, and only while it's still "reported" (EditReportView).
      // Anyone signed in may toggle their own upvote.
      allow update: if isSignedIn() &&
                     (
                       (
                         userRole() == "staff" &&
                         request.resource.data.status in ['reported', 'inProgress', 'resolved'] &&
                         (!('staffNote' in request.resource.data) || isShortText(request.resource.data.staffNote, 1000))
                       ) ||
                       (
                         resource.data.reporterId == request.auth.uid &&
                         resource.data.status == "reported" &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'description']) &&
                         isValidReport(request.resource.data)
                       ) ||
                       isOwnUpvoteChange()
                     );

      // Staff may delete any report (dashboard swipe-to-delete). Reporters
      // may delete their own: withdrawing a report, or deleting their account.
      allow delete: if isSignedIn() &&
                     (userRole() == "staff" || resource.data.reporterId == request.auth.uid);
    }

    // One photo per report, written by ReportService.swift in the same
    // batch as the report. getAfter() sees that batched report, so only the
    // report's own reporter can attach its photo. Anyone signed in (citizen
    // or staff) can view it. Size limit matches maxPhotoBytes in the app.
    match /reportPhotos/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['data'])
                    && request.resource.data.data is bytes
                    && request.resource.data.data.size() < 900 * 1024;
      allow update: if false;
      // Deleted in the same batch as its report, by staff or by the report's
      // reporter. get() sees the report as it was before the batch.
      allow delete: if isSignedIn() &&
                     (userRole() == "staff" ||
                      get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid);
    }
  }
}
