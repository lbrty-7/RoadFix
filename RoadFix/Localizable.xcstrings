    "Reported" : {
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trimisă"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Подана"
          }
        }
      }
    },
    "Reports, including their photo, description and location, are visible to everyone signed in to RoadFix and to city staff. Your email address is never shown to other users. Don't include faces, license plates or other personal details in photos or descriptions." : {
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raportările, inclusiv fotografia, descrierea și locația, sunt vizibile pentru toți utilizatorii conectați la RoadFix și pentru angajații primăriei. Adresa ta de e-mail nu este arătată niciodată altor utilizatori. Nu include fețe, numere de înmatriculare sau alte date personale în fotografii sau descrieri."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения, включая фото, описание и место, видны всем, кто вошёл в RoadFix, и сотрудникам города. Ваш e-mail никогда не показывается другим пользователям. Не добавляйте в фото и описания лица, номерные знаки и другие личные данные."
          }
        }
      }
    },
    "Reset Filters" : {
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Resetați filtrele"
          }
        },
