    "RoadFix only uses your location while the app is open, to pin new reports and show where you are on the map." : {
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RoadFix folosește locația dvs. doar cât aplicația este deschisă, pentru a marca sesizările noi și a vă arăta poziția pe hartă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "RoadFix использует вашу геопозицию, только когда приложение открыто: чтобы отмечать новые заявки и показывать, где вы находитесь на карте."
          }
