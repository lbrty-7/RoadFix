    "Deleting your account permanently removes your login, your profile and every report and photo you've submitted." : {
      "localizations" : {
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ștergerea contului elimină definitiv datele de autentificare, profilul și toate sesizările și fotografiile trimise de dvs."
